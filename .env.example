# Copy to .env.local for secrets on this machine; on Vercel, set these under
# Project › Settings › Environment Variables.

# Read posts from the content repo on GitHub (production). Leave CONTENT_DIR unset.
CONTENT_REPO=PotterWinter/blog-content-2026
CONTENT_BRANCH=main
# Fine-grained personal access token: only the content repo, Contents read-only
# (step 5 turns it read-write for the admin)
GITHUB_TOKEN=

# Dev reads fixtures/content instead (already set in .env.development). To try the
# GitHub source locally, put CONTENT_DIR= (empty) in .env.local with the two above.
# CONTENT_DIR=fixtures/content
